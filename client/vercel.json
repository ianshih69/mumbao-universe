{
  "devCommand": "npx vite --host 0.0.0.0 --configLoader runner",
  "buildCommand": "npx vite build --configLoader runner",
  "outputDirectory": "dist",
  "functions": {
    "api/ai-chat.js": {
      "includeFiles": "api/knowledge/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin-ai-quality",
      "destination": "/api/ai-quality"
    },
    {
      "source": "/api/ai-quality-feedback",
      "destination": "/api/ai-quality"
    },
    {
      "source": "/rooms/room-360-senguang",
      "destination": "/rooms/room-360-senguang/index.html"
    },
    {
      "source": "/rooms/room-530-nuanjin",
      "destination": "/rooms/room-530-nuanjin/index.html"
    },
    {
      "source": "/rooms/room-666-anhe",
      "destination": "/rooms/room-666-anhe/index.html"
    },
    {
      "source": "/rooms/room-888-xinghuo",
      "destination": "/rooms/room-888-xinghuo/index.html"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
